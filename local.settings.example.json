// Local settings for Azure Functions. Copy this file and name it local.settings.json
// and fill in the values for local development. Do not check in local.settings.json to source control,
// as it may contain sensitive information.
{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "",
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "DATABASE_URL": "postgresql://<user>:<password>@<host>:5432/<db>"
  }
}